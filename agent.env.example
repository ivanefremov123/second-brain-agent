# Настройки агента: скопируйте в %APPDATA%\SecondBrain\agent.env и заполните.
# Значения выдаёт владелец бота (позже — автоматически при подключении компьютера кодом из Telegram).

# Токен Telegram-бота: агент присылает в чат прогресс скачивания и результат запуска
BOT_TOKEN=

# Секрет подписи задач: должен совпадать с AGENT_SECRET в облаке бота
AGENT_SECRET=

# Очередь задач и канал событий облака
KVDB_BUCKET=
SMEE_CHANNEL=

# Куда скачивать проекты (по умолчанию %USERPROFILE%\Projects)
# DOWNLOADS_DIR=
