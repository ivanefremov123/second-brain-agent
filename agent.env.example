# Настройки агента: %APPDATA%\SecondBrain\agent.env.
# Обычно заполнять ничего не нужно: при первом запуске агент попросит код из бота
# («Подключить компьютер» -> «Получить код») и сам сохранит сюда номер и ключ компьютера.

# Куда скачивать проекты (по умолчанию %USERPROFILE%\Projects)
# DOWNLOADS_DIR=

# Заполняются автоматически при подключении кодом — не меняйте вручную
# DEVICE_ID=
# DEVICE_KEY=
# DEVICE_EVENTS_URL=
# DEVICE_NAME=
